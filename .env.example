# Environment variable names for local development.
# Copy this file to `.env` (git-ignored) and fill in the values there.
# Deployed secrets live in SSM Parameter Store (SecureString), never here.
# This file must contain no secret values.

# Backend (api)
# *_PARAM variables hold the SSM parameter name, never the secret value
PAYMENT_API_URL=
PAYMENT_PUBLIC_KEY=
PAYMENT_PRIVATE_KEY_PARAM=
PAYMENT_INTEGRITY_SECRET_PARAM=
PAYMENT_EVENTS_SECRET_PARAM=
ORIGIN_VERIFY_SECRET_PARAM=

# Fees in integer COP cents (300000 = 3,000 COP, 800000 = 8,000 COP)
BASE_FEE_IN_CENTS=300000
DELIVERY_FEE_IN_CENTS=800000

# DynamoDB table names
DYNAMODB_TABLE_PRODUCTS=
DYNAMODB_TABLE_CUSTOMERS=
DYNAMODB_TABLE_TRANSACTIONS=
DYNAMODB_TABLE_DELIVERIES=
DYNAMODB_TABLE_IDEMPOTENCY_KEYS=

# Frontend (web, exposed by Vite only when the name starts with VITE_)
VITE_API_BASE=/api/v1
VITE_PAYMENT_API_URL=
VITE_PAYMENT_PUBLIC_KEY=
