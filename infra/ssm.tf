data "aws_caller_identity" "current" {}

data "aws_region" "current" {}

# Origin secret: generated by Terraform and shared with CloudFront, which sends
# it as the X-Origin-Verify header. Stored as a SecureString with the default
# AWS managed key (no key_id).
resource "random_password" "origin_verify" {
  length  = 48
  special = false

  # Changing origin_secret_rotation replaces the password (see docs/deployment.md).
  keepers = {
    rotation = var.origin_secret_rotation
  }
}

resource "aws_ssm_parameter" "origin_verify" {
  name  = "/${var.project_name}/origin/verify-secret"
  type  = "SecureString"
  tier  = "Standard"
  value = random_password.origin_verify.result
}

# Payment secrets are created by the developer with the AWS CLI. They are
# intentionally NOT resources or data sources, so their values never enter the
# state or a plan. Only names and ARNs are built here.
locals {
  payment_private_key_param_name      = "/${var.project_name}/payment/private-key"
  payment_integrity_secret_param_name = "/${var.project_name}/payment/integrity-secret"
  payment_events_secret_param_name    = "/${var.project_name}/payment/events-secret"

  ssm_parameter_arn_prefix = "arn:aws:ssm:${data.aws_region.current.region}:${data.aws_caller_identity.current.account_id}:parameter"

  payment_private_key_param_arn      = "${local.ssm_parameter_arn_prefix}${local.payment_private_key_param_name}"
  payment_integrity_secret_param_arn = "${local.ssm_parameter_arn_prefix}${local.payment_integrity_secret_param_name}"
  payment_events_secret_param_arn    = "${local.ssm_parameter_arn_prefix}${local.payment_events_secret_param_name}"

  payment_secret_param_arns = [
    local.payment_private_key_param_arn,
    local.payment_integrity_secret_param_arn,
    local.payment_events_secret_param_arn,
  ]
}
